{
  "name": "users-api",
  "version": "1.0.0",
  "description": "Users REST API with Fastify 5, Prisma and PostgreSQL, structured with Clean Architecture.",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "NODE_ENV=production tsx src/server.ts",
    "build": "tsc",
    "test": "vitest run --exclude \"test/**/*.int.test.ts\"",
    "postinstall": "prisma skills sync || exit 0",
    "test:integration": "vitest run test/postgres-user.repository.int.test.ts",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate": "prisma migrate deploy",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.3",
    "@sinclair/typebox": "^0.34.52",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
