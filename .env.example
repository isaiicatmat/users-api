# Copy to .env.docker for docker compose (./up_dev.sh) and fill in the values.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=users
# postgresql://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>
DATABASE_URL=

# Tests: ./up_test.sh starts a throwaway Postgres on port 5433 (trust auth, no password)
# and sets DATABASE_URL itself.
